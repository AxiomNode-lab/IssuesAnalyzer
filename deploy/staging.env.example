APP_ENV=staging
SERVICE_NAME=opportunity-radar-web
APP_RELEASE=replace-with-git-sha
DATABASE_URL=postgresql://staging-user:replace-me@staging-db.example:5432/opportunity_radar
REDIS_URL=redis://staging-cache.example:6379
TRUSTED_PROXY_COUNT=1
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=8000
REQUIRE_DATABASE=false
GITHUB_TOKEN=replace-me
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
APP_ORIGIN=https://staging.example.com
